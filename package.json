{
  "name": "eslint-plugin-bunisms",
  "version": "0.1.0",
  "description": "ESLint rules for idiomatic and correct Bun code.",
  "keywords": [
    "bun",
    "bunjs",
    "eslint",
    "eslintplugin",
    "lint",
    "linter",
    "oxlint"
  ],
  "homepage": "https://github.com/himynameisdave/eslint-plugin-bunisms#readme",
  "bugs": "https://github.com/himynameisdave/eslint-plugin-bunisms/issues",
  "license": "MIT",
  "author": "Dave Lunny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himynameisdave/eslint-plugin-bunisms.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run test:node && bun run test:oxlint && bun run test:package",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c oxlint.config.ts --deny-warnings",
    "lint:fix": "bun run lint --fix",
    "prepublishOnly": "bun run check",
    "test": "bun test tests/rules.test.ts",
    "test:node": "node --test tests/node.test.mjs",
    "test:oxlint": "bun scripts/test-oxlint.ts",
    "test:package": "bun scripts/test-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@himynameisdave/oxfmt-config": "^1.0.0",
    "@himynameisdave/oxlint-config": "^1.2.0",
    "@types/bun": "^1.4.2",
    "@types/estree": "^1.0.9",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "eslint10": "npm:eslint@^10",
    "oxfmt": "0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0 <11"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "bun@1.4.2"
}
